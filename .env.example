# Quran.com Content API credentials (optional but recommended in production).
# The app falls back to a public Uthmani source while these are absent.
VITE_QURAN_COM_CLIENT_ID=
VITE_QURAN_COM_AUTH_TOKEN=

# Replace with licensed/official HLS links if your deployment requires them.
VITE_MAKKAH_HLS=https://example.com/makkah/playlist.m3u8
VITE_MADINAH_HLS=https://example.com/madinah/playlist.m3u8

# Contact and social links shown in the responsive footer/modal.
# WhatsApp must be digits only, including the country code (for example 201234567890).
VITE_WHATSAPP_NUMBER=YOUR_NUMBER
VITE_FACEBOOK_URL=https://www.facebook.com/your-page
VITE_INSTAGRAM_URL=https://www.instagram.com/your-account
